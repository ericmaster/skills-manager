{
  "name": "skmgr",
  "version": "0.3.5",
  "description": "Manage agentskills.io-format skills across AI agent tools, with a single source of truth and survivable customizations.",
  "type": "module",
  "bin": {
    "skills-manager": "./bin/skills-manager.js"
  },
  "main": "./dist/index.js",
  "files": [
    "bin",
    "dist",
    "src/bundled-skills"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "node --test --enable-source-maps tests/*.test.js",
    "pretest": "tsc",
    "prepublishOnly": "pnpm run build",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.0.0",
  "keywords": [
    "agent",
    "skills",
    "agentskills",
    "claude",
    "claude-code",
    "ai",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.9.4",
    "typescript": "^6.0.3"
  }
}
